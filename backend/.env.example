# Configure these in the backend hosting provider. Do not commit actual secrets.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DBNAME
SECRET_KEY=replace-with-at-least-32-random-characters
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-separate-long-random-token
ENVIRONMENT=production
CORS_ORIGINS=https://wound-care-2fwo.vercel.app
UPLOAD_DIR=./private_uploads
